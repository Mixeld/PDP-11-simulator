; PDP-11 Assembler — Листинг
; Файл: test.asm
;
АДРЕС КОД    ИСХОДНИК
------------------------------------------------------------------------        
                  ; Эхо: что введёшь, то и выведется
                  
001000:          loop:
001000: 013700       MOV  @#177560, R0      ; читаем статус клавиатуры
001002: 177560   ; src-ext
001004: 042700       BIC  #177400, R0       ; обнуляем старший байт (оставляем только младший)
001006: 177400   ; src-ext
001010: 032700       BIT  #200, R0          ; проверяем бит 7 (= 200 восьмеричное)
001012: 000200   ; src-ext
001014: 001771       BEQ  loop              ; если 0 — нет символа, ждём
                      
001016: 013700       MOV  @#177562, R0      ; читаем символ
001020: 177562   ; src-ext
001022: 042700       BIC  #177400, R0       ; оставляем только младший байт
001024: 177400   ; src-ext
                      
001026: 010037       MOV  R0, @#177566      ; выводим символ
001030: 177566   ; dst-ext
                      
001032: 000762       BR   loop              ; повторяем

------------------------------------------------------------------------
ТАБЛИЦА СИМВОЛОВ:
  loop                             001000
