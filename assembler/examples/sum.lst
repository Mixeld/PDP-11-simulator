; PDP-11 Assembler — Листинг
; Файл: examples/sum.asm
;
АДРЕС КОД    ИСХОДНИК
------------------------------------------------------------------------        
           = 001000      .ORG 01000
001000:          START:
001000: 012703       MOV #10, R3
001002: 000010   ; src-ext
001004: 005004       CLR R4
001006:          LOOP:
001006: 060304       ADD R3, R4
001010: 005303       DEC R3
001012: 001375       BNE LOOP
001014: 010400       MOV R4, R0
001016: 000000       HALT

------------------------------------------------------------------------
ТАБЛИЦА СИМВОЛОВ:
  LOOP                             001006
  START                            001000
