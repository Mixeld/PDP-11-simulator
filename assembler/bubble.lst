;
АДРЕС КОД    ИСХОДНИК
------------------------------------------------------------------------        
                  ; bubble.asm - с возвратом кода в R0
           = 001000      .ORG 01000
                      .EVEN
                  
001000:          START:
001000: 012705       MOV #ARRAY, R5
001002: 001060   ; src-ext
                      
001004:          OUTER:
001004: 005004       CLR R4
001006: 012703       MOV #10, R3
001010: 000010   ; src-ext
001012: 010500       MOV R5, R0
                      
001014:          INNER:
001014: 011001       MOV (R0), R1
001016: 016002       MOV 2(R0), R2
001020: 000002   ; src-ext
001022: 020102       CMP R1, R2
001024: 003405       BLE NOSWAP
001026: 010210       MOV R2, (R0)
001030: 010160       MOV R1, 2(R0)
001032: 000002   ; dst-ext
001034: 012704       MOV #1, R4
001036: 000001   ; src-ext
001040:          NOSWAP:
001040: 062700       ADD #2, R0
001042: 000002   ; src-ext
001044: 077315       SOB R3, INNER
001046: 005704       TST R4
001050: 001355       BNE OUTER
                      
001052: 012700       MOV #1, R0              ; успешное завершение
001054: 000001   ; src-ext
001056: 000000       HALT
                  
001060:          ARRAY:
001060:              .WORD 7, 3, 9, 1, 5, 8, 2, 4
001060: 000007
001062: 000003
001064: 000000
001066: 000001
001070: 000005
001072: 000000
001074: 000002
001076: 000004
                  

